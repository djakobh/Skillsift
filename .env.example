# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET="enter_your_auth_secret_here" # Generated by create-t3-app.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="enter_your_database_url_here"

# AI Usage
GROQ_API_KEY="enter_your_groq_api_key_here"
GEMINI_API_KEY="enter_your_gemini_api_key_here"

# Adzuna Key
ADZUNA_APP_ID="enter_your_adzuna_app_id_here"
ADZUNA_APP_KEY="enter_your_adzuna_app_key_here"

# AssemblyAI Key
ASSEMBLY_AI_API_KEY="enter_your_assemblyai_api_key_here"

# Resend Key
RESEND_API_KEY="enter_your_resend_api_key_here"
# Sender address — must be from a verified domain in your Resend account
# Use onboarding@resend.dev for testing (sends only to your registered email)
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Code execution is fail-closed. Leave false until an isolated execution backend
# has passed the live isolation acceptance test.
CODE_EXECUTION_ENABLED="false"
CODE_EXECUTION_BACKEND="disabled"

# Required when code execution is enabled in production so limits are shared by
# all Vercel instances. These values are server-only.
JUDGE_LIMITER_MODE="upstash"
JUDGE_LIMITER_NAMESPACE="skillsift:judge"
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="enter_your_server_only_token_here"

# Optional judge limits (shown with their defaults).
JUDGE_MAX_BODY_BYTES="81920"
JUDGE_MAX_CODE_BYTES="65536"
JUDGE_MAX_STDIN_BYTES="8192"
JUDGE_RATE_LIMIT_MAX="5"
JUDGE_RATE_LIMIT_WINDOW_MS="60000"
JUDGE_MAX_CONCURRENT_PER_USER="1"
JUDGE_MAX_CONCURRENT_GLOBAL="4"
JUDGE_REQUEST_TIMEOUT_MS="15000"
JUDGE_SANDBOX_TIMEOUT_MS="12000"
JUDGE_EXECUTION_TIMEOUT_MS="5000"
JUDGE_MAX_OUTPUT_BYTES="65536"
JUDGE_SANDBOX_MEMORY_BYTES="536870912"
JUDGE_SANDBOX_MAX_PROCESSES="64"
JUDGE_SANDBOX_MAX_FILE_BYTES="1048576"

# Retired Railway broker. Keep execution false or remove the service after the
# Vercel Sandbox path is verified; these are not used by the Next.js backend.
RUNNER_SHARED_SECRET="generate_at_least_32_random_bytes"
RUNNER_ALLOWED_LANGUAGES="python"
RUNNER_MAX_REQUEST_BYTES="307200"
RUNNER_MAX_SOURCE_BYTES="262144"
RUNNER_MAX_STDIN_BYTES="8192"
RUNNER_MAX_OUTPUT_BYTES="65536"
RUNNER_MAX_CONCURRENT_JOBS="2"

# Railway video analysis service.
PORT="enter_your_port_here"
ANALYZER_URL="enter_your_analyzer_url_here"
ANALYZER_SECRET="enter_your_analyzer_secret_here"
